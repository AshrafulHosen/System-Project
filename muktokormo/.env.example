# --- AI features (Proposal Assistant & Project Brief Generator) ---------------
# Server-side only. Never prefix these with NEXT_PUBLIC_.
# Without a key the AI buttons show a "not configured" state.
# Provider: "gemini" or "openai" (auto-detected from the key you set, Gemini first)
AI_PROVIDER=gemini
# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: primary model + comma-separated fallbacks used when a model is overloaded
AI_MODEL=gemini-3.5-flash
AI_FALLBACK_MODELS=gemini-3.5-flash-lite
# --- or OpenAI instead ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: per-attempt timeout in ms (5000–120000)
AI_TIMEOUT_MS=
